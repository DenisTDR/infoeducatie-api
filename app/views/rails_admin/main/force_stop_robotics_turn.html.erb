<section class="ie-api-key-panel">
  <h3>Force-stop <%= @object.label %>?</h3>
  <p>
    Actual elapsed seconds will be charged and the arena will enter its normal
    turnover interval.
  </p>

  <% if @force_stop_error %>
    <div class="alert alert-danger" role="alert">
      <%= @force_stop_error.message %>
    </div>
  <% end %>

  <% if @object.active? %>
    <% submitted = (@submitted_force_stop || {}).with_indifferent_access %>
    <%= form_tag request.path, method: :post do %>
      <div class="form-group">
        <%= label_tag "force_stop_reason", "Reason" %>
        <%= text_area_tag "force_stop[reason]", submitted[:reason],
          class: "form-control", required: true, rows: 3 %>
      </div>
      <div class="form-actions">
        <%= submit_tag "Force-stop turn", class: "btn btn-danger" %>
        <%= link_to "Cancel", index_path, class: "btn btn-default" %>
      </div>
    <% end %>
  <% else %>
    <div class="form-actions">
      <%= link_to "Back to robotics turns", index_path,
        class: "btn btn-primary" %>
    </div>
  <% end %>
</section>
