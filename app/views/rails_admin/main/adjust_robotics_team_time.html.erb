<section class="ie-api-key-panel">
  <h3>Adjust time for <%= @object.name %></h3>
  <p>
    Current ledger balance:
    <strong><%= @object.balance_seconds / 60.0 %> minutes</strong>.
    This creates an immutable, administrator-attributed ledger entry.
  </p>

  <% if @adjustment_error %>
    <div class="alert alert-danger" role="alert">
      <%= @adjustment_error.message %>
    </div>
  <% end %>

  <%= form_tag request.path, method: :post do %>
    <div class="form-group">
      <%= label_tag "time_adjustment_minutes", "Minutes" %>
      <%= number_field_tag "time_adjustment[minutes]", nil,
        class: "form-control", required: true %>
      <p class="help-block">
        Use a positive number to add time and a negative number to deduct it.
      </p>
    </div>
    <div class="form-group">
      <%= label_tag "time_adjustment_reason", "Reason" %>
      <%= text_area_tag "time_adjustment[reason]", nil,
        class: "form-control", required: true, rows: 3 %>
    </div>
    <div class="form-actions">
      <%= submit_tag "Record adjustment", class: "btn btn-primary" %>
      <%= link_to "Cancel", index_path, class: "btn btn-default" %>
    </div>
  <% end %>
</section>
